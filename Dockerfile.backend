# syntax=docker/dockerfile:1.4
FROM node:24-slim AS base
RUN corepack enable && corepack prepare pnpm@9 --activate && npm install -g npm@12.0.2

# Install system deps: openssl (Prisma), ffmpeg (audio), python3+pip (yt-dlp),
# curl (Deno installer)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      openssl \
      ffmpeg \
      python3 \
      python3-pip \
      curl \
      unzip \
      ca-certificates \
    && python3 -m pip install --break-system-packages --no-cache-dir -U "yt-dlp[default]" \
    && curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy everything at once to avoid BuildKit ordering bug on Windows
FROM base AS build
COPY . .
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @ts6/common run build
RUN pnpm --filter @ts6/backend exec prisma generate
RUN pnpm --filter @ts6/backend run build
# Replace the workspace-wide node_modules (the build above needed all of it,
# the frontend's vite/tailwind/rolldown toolchain included) with the backend's
# own production dependencies before it gets copied into the production image
# below. None of that tooling runs at runtime, and it was dragging in a lot of
# avoidable CVE surface for zero benefit. `pnpm prune --prod` cannot do this:
#   - in a workspace it only acts on the root project (which has nothing but
#     typescript), so the other packages' dependencies stay either way;
#   - it first asks "The modules directories will be removed and reinstalled
#     from scratch. Proceed?" and a RUN step has no TTY to answer, so it exited
#     0 having done nothing -- this line used to be a silent no-op;
#   - with CI=true to skip that prompt it does run, and empties the
#     node_modules of every workspace package, the backend's included.
# A reinstall from the lockfile into an emptied tree has neither problem. The
# pnpm store from the install above is still on disk, so nothing is downloaded
# again; --frozen-lockfile keeps it to the versions that were just built, and
# --filter @ts6/backend... limits it to the backend and @ts6/common. Beyond the
# backend's own dependencies, what stays is what those need at runtime: the
# prisma CLI and its dependencies (`prisma db push`), tsx and its esbuild
# (`prisma db seed`).
RUN rm -rf node_modules packages/*/node_modules && \
    pnpm install --prod --frozen-lockfile --filter @ts6/backend...
# Fail the build rather than quietly ship the frontend toolchain again.
RUN if ls node_modules/.pnpm | grep -q -E '^(vite|rolldown|tailwindcss)@'; then \
      echo 'frontend build tooling is still in node_modules' >&2; exit 1; fi

# Production image
FROM base AS production
ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build /app/packages/common/dist ./packages/common/dist
COPY --from=build /app/packages/common/package.json ./packages/common/package.json
COPY --from=build /app/packages/backend/dist ./packages/backend/dist
# prisma/seed.ts runs via tsx against source, not dist -- it needs the
# generated client's .ts source alongside it, not just the compiled dist copy.
COPY --from=build /app/packages/backend/src/generated ./packages/backend/src/generated
COPY --from=build /app/packages/backend/prisma ./packages/backend/prisma
COPY --from=build /app/packages/backend/prisma.config.ts ./packages/backend/prisma.config.ts
COPY --from=build /app/packages/backend/package.json ./packages/backend/package.json
COPY --from=build /app/packages/backend/node_modules ./packages/backend/node_modules

WORKDIR /app/packages/backend
# --js-runtimes deno: YouTube extraction needs a JS runtime to solve the nsig
# challenge; Deno is yt-dlp's supported default (see deno.land install above).
# (No player_client override here: web_music was this vserver's SinusBot
# audio-only workaround and caps video formats to itag 18/360p -- wrong for
# the video streaming path, which needs the default client's full format list.)
RUN mkdir -p data /data/music && \
    mkdir -p /root/.config/yt-dlp && \
    printf '%s\n' \
      '--js-runtimes deno' \
      > /root/.config/yt-dlp/config

EXPOSE 3001
ENV SIDECAR_URL=http://ts6-sidecar:9800
# yt-dlp is baked in at build time (above) and would otherwise only ever get
# newer on a rebuild - YouTube extraction breaks on its own schedule as sites
# change, independent of when this image last got rebuilt. Check for an
# update on every container start; non-fatal if it fails (offline, PyPI
# unreachable, ...) so a network hiccup at boot never blocks startup.
#
# `prisma db push --accept-data-loss`: this project has no formal migrations -
# db push IS the schema-sync step, applied on every start, and every schema
# change is already reviewed as a PR before it ships, so the interactive
# data-loss confirmation prisma would otherwise demand can never actually be
# answered here anyway. --accept-data-loss unblocks that stuck prompt.
# Without it, db push exits non-zero on a column removal - and the `&&`/`||`
# chaining below it MUST leave that failure fatal (stop the container),
# not fall through to starting the backend against an unmigrated schema: a
# real production deploy hit exactly this - db push failed, got silently
# swallowed by `... || true && exec node ...` (the `|| true` was only meant
# to tolerate `db seed` failing, e.g. on a re-run where seed rows already
# exist, but its scope leaked to the whole left-hand chain including db push
# itself) - and the backend booted anyway with a stale schema. The explicit
# `(... || true)` grouping below scopes that tolerance to db seed only.
CMD ["sh", "-c", "(python3 -m pip install --break-system-packages --no-cache-dir -U yt-dlp && echo \"[yt-dlp] $(yt-dlp --version)\") || echo '[yt-dlp] Update check failed, continuing with existing version'; npx prisma db push --accept-data-loss && (npx prisma db seed || true) && exec node dist/index.js"]
