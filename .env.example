# Backend
NODE_ENV=development
PORT=3001
DATABASE_URL="file:./data/ts6webui.db"
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
FRONTEND_URL=http://localhost:5173
# Largest single file the Files page will upload, in megabytes
FILES_MAX_UPLOAD_MB=100
# How many reverse proxies stand between a visitor and the backend, so it knows
# which entry of X-Forwarded-For is the visitor. 1 = the frontend container's
# nginx alone (the default). A host nginx / Coolify in front makes it 2.
# A comma-separated list of proxy addresses works too. Too low shows the
# proxy's address instead of the visitor's, too high believes addresses the
# visitor made up. Settings -> Network shows what fits.
# TRUST_PROXY=1

# Frontend (Vite env vars)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws
