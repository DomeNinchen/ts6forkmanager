# syntax=docker/dockerfile:1.4
FROM golang:1.26-trixie AS build
WORKDIR /src
COPY packages/sidecar/go.mod packages/sidecar/go.sum ./
RUN go mod download
COPY packages/sidecar/*.go .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /sidecar .

# Debian 13 (trixie), not 12: bookworm left the Debian security team's regular
# support in July 2026 and only gets LTS updates now, while trixie is the
# current stable release (and ships ffmpeg 7.1 instead of 5.1).
FROM debian:trixie-slim
# `apt-get upgrade` first: the base image is only rebuilt every now and then, so
# security fixes that are already published would otherwise ride along until the
# next base image.
RUN apt-get update && \
    apt-get -y upgrade && \
    apt-get install -y --no-install-recommends ffmpeg ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
# Runs as uid/gid 1000, the same as the backend's node user: the two containers
# share the music volume (the backend writes the files, ffmpeg here reads them).
# /data/music is created and owned the way the backend image has it, so the
# volume gets the same owner whichever container mounts it first.
RUN groupadd --gid 1000 sidecar && \
    useradd --uid 1000 --gid 1000 --no-create-home --shell /usr/sbin/nologin sidecar && \
    install -d -o sidecar -g sidecar /data/music
COPY --from=build /sidecar /usr/local/bin/sidecar
USER sidecar
EXPOSE 9800
# GET /health over a plain TCP socket: the image has no curl or wget, and bash
# is already there.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/${SIDECAR_PORT:-9800} && printf "GET /health HTTP/1.0\r\n\r\n" >&3 && head -n 1 <&3 | grep -q " 200 "'
CMD ["sidecar"]
