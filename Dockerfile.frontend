# syntax=docker/dockerfile:1.4
FROM node:24-slim AS base
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Copy everything at once to avoid BuildKit ordering bug on Windows
FROM base AS build
COPY . .
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @ts6/common run build
RUN pnpm --filter @ts6/frontend run build

# Production: serve with nginx
FROM nginx:alpine AS production

COPY --from=build /app/packages/frontend/dist /usr/share/nginx/html

# Nginx config for SPA routing + API proxy
RUN printf 'server {\n\
    listen 80;\n\
    server_name _;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    client_max_body_size 150m;\n\
\n\
    # File body of a Files page upload. The backend decides how large it may be\n\
    # (FILES_MAX_UPLOAD_MB, announced up front and checked against the real body),\n\
    # so nginx neither caps it nor collects it on disk first.\n\
    location ~ ^/api/servers/[0-9]+/vs/[0-9]+/files/[0-9]+/uploads/[A-Za-z0-9_-]+$ {\n\
        client_max_body_size 0;\n\
        proxy_request_buffering off;\n\
        proxy_read_timeout 3600s;\n\
        proxy_send_timeout 3600s;\n\
        proxy_pass http://backend:3001;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
    }\n\
\n\
    # One-time file download links: stream straight through instead of collecting\n\
    # the whole file in nginx first\n\
    location /api/file-downloads/ {\n\
        proxy_buffering off;\n\
        proxy_read_timeout 3600s;\n\
        proxy_pass http://backend:3001;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
    }\n\
\n\
    location /api {\n\
        proxy_pass http://backend:3001;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
    }\n\
\n\
    location /ws {\n\
        proxy_pass http://backend:3001;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
    }\n\
\n\
    location /widget/ {\n\
        add_header X-Frame-Options "" always;\n\
        add_header Content-Security-Policy "default-src '"'"'self'"'"'; script-src '"'"'self'"'"'; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; font-src '"'"'self'"'"' data:; img-src '"'"'self'"'"' data: blob:; media-src '"'"'self'"'"' blob:; connect-src '"'"'self'"'"'; frame-ancestors *; base-uri '"'"'self'"'"'; form-action '"'"'self'"'"'; object-src '"'"'none'"'"'" always;\n\
        add_header X-Content-Type-Options "nosniff" always;\n\
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;\n\
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;\n\
        add_header Cross-Origin-Resource-Policy "same-origin" always;\n\
        add_header Cross-Origin-Opener-Policy "same-origin" always;\n\
        add_header Cross-Origin-Embedder-Policy "credentialless" always;\n\
        # index.html is served in place. A last try_files argument of /index.html\n\
        # would be an internal redirect that is matched against location / again,\n\
        # and the response would carry the SAMEORIGIN headers of that block\n\
        # instead of the ones above, so the widget could not be embedded elsewhere.\n\
        try_files $uri /index.html =404;\n\
    }\n\
\n\
    location / {\n\
        add_header X-Frame-Options "SAMEORIGIN" always;\n\
        add_header Content-Security-Policy "default-src '"'"'self'"'"'; script-src '"'"'self'"'"'; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; font-src '"'"'self'"'"' data:; img-src '"'"'self'"'"' data: blob:; media-src '"'"'self'"'"' blob:; connect-src '"'"'self'"'"'; frame-ancestors '"'"'self'"'"'; base-uri '"'"'self'"'"'; form-action '"'"'self'"'"'; object-src '"'"'none'"'"'" always;\n\
        add_header X-Content-Type-Options "nosniff" always;\n\
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;\n\
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;\n\
        add_header Cross-Origin-Resource-Policy "same-origin" always;\n\
        add_header Cross-Origin-Opener-Policy "same-origin" always;\n\
        add_header Cross-Origin-Embedder-Policy "credentialless" always;\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    gzip on;\n\
    gzip_types text/plain text/css application/json application/javascript text/xml;\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
