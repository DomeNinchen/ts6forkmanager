generator client {
  provider           = "prisma-client"
  output             = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  // Nullable: an SSO-only account (authProvider "oidc") never has a local
  // password, so there's nothing to bcrypt-compare against at /login - such
  // an account can only authenticate via the OIDC flow.
  passwordHash String?
  email        String?   @unique
  // The OIDC provider's "sub" claim - the stable identifier that survives an
  // email change at the IdP, so this (not email) is the real join key for
  // "is this the same person logging in again".
  externalId   String?   @unique
  authProvider String    @default("local") // "local" | "oidc"
  displayName  String
  role         String    @default("viewer")
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  // WebGUI display language ("en" | "de"). Null = auto-detect from the
  // browser on first load rather than a stored preference.
  language     String?

  // TOTP secret, encrypted at rest via utils/crypto.ts (same helper used for
  // TS server credentials). Set as soon as setup starts, but totpEnabled only
  // flips true once the user proves they can actually generate a valid code.
  totpSecret  String?
  totpEnabled Boolean @default(false)

  serverAccess   UserServerAccess[]
  refreshTokens  RefreshToken[]
  recoveryCodes  RecoveryCode[]
  trustedDevices TrustedDevice[]
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  family     String?
  replacedBy String?
}

// One-time-use 2FA recovery codes, issued as a batch when TOTP setup completes.
// Stored bcrypt-hashed like a password - never recoverable once shown to the user.
model RecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// "Remember this device" for 2FA - a device holding a valid, unexpired token here
// skips the TOTP challenge on login. Stored the same way RefreshToken.token is
// (unique, high-entropy, looked up by exact match) - not a password, so not bcrypt-hashed.
model TrustedDevice {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UserServerAccess {
  id             Int            @id @default(autoincrement())
  userId         Int
  serverConfigId Int
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverConfig   TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)

  @@unique([userId, serverConfigId])
}

model TsServerConfig {
  id           Int      @id @default(autoincrement())
  name         String
  host         String
  webqueryPort Int      @default(10080)
  apiKey       String
  useHttps     Boolean  @default(false)
  sshPort      Int      @default(10022)
  sshUsername  String?
  sshPassword  String?
  // Dashboard's "real reachability" ping target - deliberately separate from
  // `host` above (which bot flows and every WebQuery/SSH call keep using
  // regardless of this field). host is often an internal/Docker-network
  // address; the public domain a ping test should actually reach can be
  // different. Falls back to `host` when left unset.
  pingHost     String?
  // Custom nickname for this connection's own (shared/admin) query identity -
  // distinct from botQueryName above, which only covers bot-flow actions. This
  // is what a manual action taken through the WebUI itself (e.g. renaming a
  // channel) shows as the actor in TS's own logs. Re-applied on every
  // (re)connect the same way botQueryName is, since a freshly-constructed
  // WebQueryClient is a new query client as far as TS is concerned. Null
  // means "whatever TS assigns by default" (usually "serveradmin").
  queryNickname String?
  enabled      Boolean  @default(true)
  // Whether UserHistorySampler records this connection's virtual servers in
  // the long-term user-count history (Statistics -> History). On by default so
  // a new connection has history from its first minute; the switch exists for
  // admins who would rather not poll a particular (remote, metered, or simply
  // uninteresting) connection every interval. Turning it off keeps whatever
  // was already recorded and only stops adding to it.
  recordUserHistory Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Optional, separate ServerQuery identity used only for bot-flow actions
  // (created via queryloginadd + apikeyadd), so bot flows are attributed to
  // their own name in TS's own logs/notifications instead of blurring
  // together with this connection's own "admin" identity, which every
  // manual action taken through the WebUI also uses. botApiKey is null
  // until provisioned - bot flows fall back to the main connection until then.
  botQueryName String?
  botApiKey    String?
  // Set alongside botApiKey from PR #119 onward - lets a later re-provision
  // (e.g. to reissue the API key with a corrected scope) find the exact same
  // underlying ServerQuery login by id instead of by name, since botQueryName
  // can drift from the original client_login_name after a rename (renaming
  // only changes the in-game nickname; TS has no command to rename a query
  // login itself). Null for any identity created before this field existed.
  botCldbid    Int?

  userAccess    UserServerAccess[]
  botFlows      BotFlow[]
  botLogs       BotExecutionLog[]
  musicBots     MusicBot[]
  songs         Song[]
  radioStations RadioStation[]
  widgets       Widget[]
  musicRequests MusicRequest[]
  commandPermissions  BotCommandPermission[]
  commandAdminGroups  BotCommandAdminGroup[]
  metricSamples       ServerMetricSample[]
  userSamples         ServerUserSample[]
}

model BotFlow {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  flowData        String   @default("{\"nodes\":[],\"edges\":[]}")
  serverConfigId  Int
  virtualServerId Int      @default(1)
  serverConfig    TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  executions BotExecution[]
  variables  BotVariable[]
}

model BotVariable {
  id     Int     @id @default(autoincrement())
  flowId Int
  flow   BotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  name   String
  value  String  @default("")
  scope  String  @default("flow")

  @@unique([flowId, name, scope])
}

model BotExecution {
  id          Int       @id @default(autoincrement())
  flowId      Int
  flow        BotFlow   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  triggeredBy String
  triggerData String?
  status      String    @default("running")
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  error       String?

  logs BotExecutionLog[]
}

model BotExecutionLog {
  id             Int            @id @default(autoincrement())
  executionId    Int?
  execution      BotExecution?  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  serverConfigId Int
  serverConfig   TsServerConfig @relation(fields: [serverConfigId], references: [id])
  flowId         Int?
  nodeId         String?
  nodeName       String?
  level          String         @default("info")
  message        String
  data           String?
  timestamp      DateTime       @default(now())

  @@index([executionId])
  @@index([flowId])
  @@index([timestamp])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// === Music / Voice Bot Models ===

model MusicBot {
  id              Int       @id @default(autoincrement())
  name            String
  serverConfigId  Int
  serverConfig    TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  nickname        String    @default("MusicBot")
  serverPassword  String?
  defaultChannel  String?
  channelPassword String?
  voicePort       Int       @default(9987)
  volume          Int       @default(50)
  identityData    String?
  autoStart       Boolean   @default(false)
  // Superseded by the global "stream defaults" app settings (see
  // utils/stream-defaults.ts). Kept so no existing deployment loses a
  // column on the next `prisma db push`, but nothing reads it any more.
  streamPreset    String    @default("720p")
  sidecarPort     Int       @default(9800)
  descriptionTemplate String?
  avatarData      Bytes?
  avatarMimeType  String?
  // What to start playing on its own, every time this bot connects
  // (manual Start, backend restart via autoStart, or an automatic
  // reconnect) - only when it comes up with an empty queue, so it never
  // overrides whatever was already lined up. "none" leaves it idle, same
  // as before this existed.
  autoplayMode           String        @default("none") // "none" | "song" | "radio"
  autoplaySongId         Int?
  autoplaySong           Song?         @relation(fields: [autoplaySongId], references: [id], onDelete: SetNull)
  autoplayRadioStationId Int?
  autoplayRadioStation   RadioStation? @relation(fields: [autoplayRadioStationId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  playlists Playlist[]
}

model Song {
  id              Int       @id @default(autoincrement())
  title           String
  artist          String?
  duration        Float?
  filePath        String
  source          String    @default("local")
  sourceUrl       String?
  fileSize        Int?
  mediaType       String    @default("audio")
  serverConfigId  Int
  serverConfig    TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  playlistSongs PlaylistSong[]
  autoplayingBots MusicBot[]
}

model Playlist {
  id         Int       @id @default(autoincrement())
  name       String
  musicBotId Int?
  musicBot   MusicBot? @relation(fields: [musicBotId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  songs PlaylistSong[]
}

model PlaylistSong {
  id         Int      @id @default(autoincrement())
  playlistId Int
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  songId     Int
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  position   Int      @default(0)

  @@unique([playlistId, songId])
}

model RadioStation {
  id             Int            @id @default(autoincrement())
  name           String
  url            String
  genre          String?
  imageUrl       String?
  serverConfigId Int
  serverConfig   TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  autoplayingBots MusicBot[]
}

// === Server Widget / Banner ===

model Widget {
  id              Int            @id @default(autoincrement())
  name            String
  token           String         @unique
  serverConfigId  Int
  serverConfig    TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  virtualServerId Int            @default(1)
  theme           String         @default("dark")
  showChannelTree Boolean        @default(true)
  showClients     Boolean        @default(true)
  hideEmptyChannels Boolean      @default(false)
  maxChannelDepth Int            @default(5)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model MusicRequest {
  id             Int            @id @default(autoincrement())
  title          String
  url            String
  serverConfigId Int
  serverConfig   TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  requestedAt    DateTime       @default(now())

  @@unique([serverConfigId, url])
}

model StreamSession {
  id             Int       @id @default(autoincrement())
  musicBotId     Int
  source         String
  preset         String    @default("720p")
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  peakViewers    Int       @default(0)
}

// === Chat Command Permissions (DomeNinchen/ts6forkmanager#184) ===
// Restricts which TeamSpeak server groups may run a given "!command" in
// bot chat (MusicBot today; the check itself is command-name-keyed and not
// tied to MusicBot specifically, so other bot-triggered commands can reuse
// it later). No row for a command, or an empty allowedGroupIds, means
// "everyone can use it" - the default the feature request asked for.
model BotCommandPermission {
  id              Int      @id @default(autoincrement())
  serverConfigId  Int
  serverConfig    TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  command         String
  // Comma-separated TeamSpeak server group IDs (sgid). Stored as a CSV
  // string rather than a relation table, matching how group membership is
  // already represented elsewhere in this app (e.g. bot-flow condition
  // nodes, see utils/group-match.ts) - these IDs are TeamSpeak's own and
  // aren't rows in this database.
  allowedGroupIds String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([serverConfigId, command])
}

// Server groups that bypass every BotCommandPermission restriction on a
// given server config - the feature request's "Admin bypasses all commands".
// Kept separate from BotCommandPermission rather than a magic command name,
// since it applies globally and shouldn't need re-adding to every command.
model BotCommandAdminGroup {
  id             Int      @id @default(autoincrement())
  serverConfigId Int
  serverConfig   TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  groupId        String   // a single TeamSpeak sgid, as a string for consistency with allowedGroupIds above
  createdAt      DateTime @default(now())

  @@unique([serverConfigId, groupId])
}

// === Dashboard metric history ===
// One row per bandwidth/ping measurement taken by BandwidthSampler. This
// exists so the dashboard's charts can show a full time window the moment
// they are opened, instead of starting empty and filling in only while
// somebody is watching. An in-memory ring buffer alone cannot do that: it is
// lost on every backend restart, and the backend restarts on every
// deployment - so the charts would be short of history exactly after an
// update.
//
// Rows are pruned to the sampler's retention window on every sample, so this
// table stays tiny: at a 30s interval that is roughly 40 rows per virtual
// server, not a growing archive. It is deliberately not a general metrics
// store - if longer-term history is ever wanted, the retention window in
// bandwidth-sampler.ts is the single knob to change.
model ServerMetricSample {
  id              Int      @id @default(autoincrement())
  serverConfigId  Int
  serverConfig    TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  // TeamSpeak's own virtual server id (sid). Not a row in this database, so
  // a plain Int rather than a relation - consistent with how sid is carried
  // on BotFlow.virtualServerId.
  virtualServerId Int
  measuredAt      DateTime @default(now())
  // Bytes per second, as reported by serverrequestconnectioninfo.
  incoming        Int
  outgoing        Int
  // Round-trip time in ms of a TCP connect to the server's own host, or -1
  // when it was unreachable - see BandwidthSampler.tcpPing for why this is
  // measured rather than read from virtualserver_total_ping.
  ping            Int

  // Every read is "this server's samples in time order" and every prune is
  // "everything older than X" - one composite index serves both.
  @@index([serverConfigId, virtualServerId, measuredAt])
}

// === Long-term user-count history (Statistics -> History) ===
// One row per virtual server per UserHistorySampler tick. Unlike
// ServerMetricSample above (a 20-minute window for the dashboard's live
// charts), this is a deliberate archive: the retention is an admin setting
// (default 32 days, enough for the chart's longest window plus a day of
// lead-in for its 24-hour average) and a tick is ~90 bytes, so a month at the
// default 60s interval is about 44,000 rows / 4 MB per virtual server.
//
// A row is written for every tick whether or not anyone could be counted,
// with `state` saying why - that is what lets the chart tell "nobody was
// online" (users = 0) apart from "we could not look" (no number at all).
// Stretches with no rows at all mean the backend itself was not running.
model ServerUserSample {
  id              Int      @id @default(autoincrement())
  serverConfigId  Int
  serverConfig    TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  // TeamSpeak's own virtual server id (sid) - not a row in this database,
  // same as ServerMetricSample.virtualServerId.
  virtualServerId Int
  measuredAt      DateTime @default(now())
  // "online"      - the virtual server answered and `users` is a real count
  // "stopped"     - the instance answered but this virtual server is not
  //                 running (offline, booting up, shutting down, virtual online)
  // "unreachable" - the instance itself could not be reached (network error or
  //                 timeout), so nothing is known about this virtual server
  state           String
  // Real users only: virtualserver_clientsonline minus
  // virtualserver_queryclientsonline, the same figure the Virtual Servers page
  // shows. Null unless state is "online" - never 0 as a stand-in for unknown.
  users           Int?
  // The sampling interval in force when this row was written, in seconds. It
  // is stored per row because the interval is an admin setting: the chart
  // decides whether two neighbouring rows are "one sample apart" or "a gap"
  // from the interval that applied at the time, which stays correct after the
  // setting has been changed.
  intervalSec     Int

  // Reads are "this virtual server's rows in time order" and the periodic
  // prune is "everything older than X" - one composite index serves both.
  @@index([serverConfigId, virtualServerId, measuredAt])
}
